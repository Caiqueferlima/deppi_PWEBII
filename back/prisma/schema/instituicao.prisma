model Instituicao {
  id        String   @id @default(uuid())
  nome      String
  campus    String
  cidade    String
  cnpj      String?  @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios User[]

  cursos CursoExtensao[]

  departamentos Departamento[]

  @@map("instituicoes")
}
